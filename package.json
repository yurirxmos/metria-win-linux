{
  "name": "metria-electron",
  "version": "0.1.11",
  "private": false,
  "description": "Cross-platform Electron implementation of Metria",
  "author": "Metria <metria@users.noreply.github.com>",
  "homepage": "https://github.com/yurirxmos/metria-win-linux",
  "desktopName": "Metria Electron",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.json && vite build && node scripts/copy-renderer-assets.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "node --test dist/test/*.test.js",
    "check": "npm run typecheck && npm run build && npm run test",
    "package": "npm run build && electron-builder --config electron-builder.yml --publish never"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "electron-updater": "^6.8.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
